{
  "name": "@gopherium/react-auth",
  "version": "0.19.0",
  "description": "Session authentication for React apps backed by gouncer's authkit.",
  "license": "Apache-2.0",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/gopherium/gouncer.git",
    "directory": "react-auth"
  },
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./admin": {
      "types": "./dist/admin/index.d.ts",
      "default": "./dist/admin/index.js"
    },
    "./wpds": {
      "types": "./dist/wpds/index.d.ts",
      "default": "./dist/wpds/index.js"
    },
    "./wpds/users": {
      "types": "./dist/wpds/users/index.d.ts",
      "default": "./dist/wpds/users/index.js"
    },
    "./wpds/style.css": "./dist/wpds/style.css",
    "./languages/*": "./dist/languages/*",
    "./testing": {
      "types": "./dist/testing/index.d.ts",
      "default": "./dist/testing/index.js"
    }
  },
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json && cp src/wpds/style.css dist/wpds/style.css && cp -R src/languages dist/languages",
    "catalogs": "node scripts/write-catalogs.ts",
    "cover": "vitest run --coverage",
    "pot": "node scripts/write-pot.ts",
    "lint": "oxlint",
    "prepublishOnly": "pnpm run build"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "zod": "^4.4.3",
    "zxcvbn": "4.4.1"
  },
  "peerDependencies": {
    "@gopherium/godmin": ">=0.31.0 <0.32.0",
    "@gopherium/gottext": ">=0.8.0 <0.9.0",
    "@tanstack/react-query": "^5.101.2",
    "@testing-library/jest-dom": "^6.9.1 || ^7.0.0",
    "@testing-library/react": "^16.3.2",
    "@wordpress/components": ">=43.0.0 <44.0.0",
    "@wordpress/dataviews": ">=21.0.0 <22.0.0",
    "@wordpress/date": ">=6.0.0 <7.0.0",
    "@wordpress/i18n": ">=7.0.0 <8.0.0",
    "@wordpress/icons": ">=19.0.0 <20.0.0",
    "@wordpress/theme": ">=3.0.0 <4.0.0",
    "@wordpress/ui": ">=0.25.0 <0.26.0",
    "msw": "^3.0.0",
    "react": "^19.2.7",
    "vitest": "^5.0.4"
  },
  "peerDependenciesMeta": {
    "@gopherium/godmin": {
      "optional": true
    },
    "@gopherium/gottext": {
      "optional": true
    },
    "@testing-library/jest-dom": {
      "optional": true
    },
    "@testing-library/react": {
      "optional": true
    },
    "@wordpress/components": {
      "optional": true
    },
    "@wordpress/dataviews": {
      "optional": true
    },
    "@wordpress/date": {
      "optional": true
    },
    "@wordpress/icons": {
      "optional": true
    },
    "@wordpress/theme": {
      "optional": true
    },
    "@wordpress/ui": {
      "optional": true
    },
    "msw": {
      "optional": true
    },
    "vitest": {
      "optional": true
    }
  },
  "devDependencies": {
    "@gopherium/godmin": "0.31.0",
    "@gopherium/gottext": "0.8.0",
    "@tanstack/react-query": "^5.101.2",
    "@tanstack/react-router": "^1.170.44",
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/gettext-parser": "9.0.0",
    "@types/node": "^26.1.1",
    "@types/react": "^19.2.17",
    "@types/zxcvbn": "4.4.5",
    "@vitejs/plugin-react": "^6.0.3",
    "@vitest/coverage-v8": "^5.0.5",
    "@wordpress/a11y": "5.0.0",
    "@wordpress/components": "43.0.0",
    "@wordpress/dataviews": "21.0.0",
    "@wordpress/date": "6.0.0",
    "@wordpress/i18n": "7.0.0",
    "@wordpress/icons": "19.0.0",
    "@wordpress/style-runtime": "0.14.0",
    "@wordpress/theme": "3.0.0",
    "@wordpress/ui": "0.25.0",
    "eslint": "^9.39.1",
    "eslint-plugin-jsdoc": "^63.0.13",
    "eslint-plugin-sonarjs": "^4.2.0",
    "eslint-plugin-tsdoc": "^0.4.0",
    "gettext-extractor": "4.0.6",
    "gettext-parser": "9.1.1",
    "jsdom": "^30.1.2",
    "msw": "^3.0.3",
    "oxlint": "^1.71.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.46.4",
    "vite": "^8.1.4",
    "vitest": "^5.0.5"
  }
}
